{
  "name": "@qzlfee/phoenix-agent",
  "version": "0.1.1",
  "description": "Local-first AI agent with web UI and streaming LLM responses",
  "type": "module",
  "bin": {
    "phoenix-agent": "bin/cli.js"
  },
  "main": "./dist/server/index.js",
  "files": [
    "dist/",
    "bin/",
    "public/",
    "README.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev:web": "vite",
    "dev:server": "tsup src/server/index.ts src/cli/index.ts --format esm --watch --external better-sqlite3 --external dockerode",
    "dev": "npm run build:server && node bin/cli.js",
    "build:web": "vite build",
    "build:server": "tsup src/server/index.ts src/cli/index.ts --format esm --external better-sqlite3 --external dockerode --out-dir dist",
    "build": "npm run build:server && npm run build:web",
    "prepublishOnly": "npm run build",
    "start": "node bin/cli.js"
  },
  "keywords": [
    "ai",
    "agent",
    "llm",
    "fastify",
    "react",
    "vite",
    "local-first",
    "cli"
  ],
  "author": "Phoenix Team",
  "license": "MIT",
  "dependencies": {
    "@ai-sdk/openai": "^4.0.117",
    "@fastify/cors": "^11.4.3",
    "@fastify/multipart": "^10.1.8",
    "@fastify/static": "^10.1.11",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@monaco-editor/react": "^4.7.0",
    "@types/dockerode": "^4.0.2",
    "ai": "^7.0.172",
    "better-sqlite3": "^13.1.1",
    "chalk": "^6.0.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dockerode": "^5.0.1",
    "fastify": "^5.12.8",
    "lucide-react": "^1.72.0",
    "open": "^11.0.4",
    "ora": "^10.0.0",
    "prompts": "^2.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.6.6",
    "@types/prompts": "^2.4.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.5",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
